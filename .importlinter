# The layering, enforced rather than described.
#
# Every rule here was already stated in a docstring somewhere. A docstring is a
# promise; this is the thing that notices when the promise is broken, on the
# commit that breaks it rather than during a review months later.

[importlinter]
root_package = salesforce_connector
# Required to name third-party packages in a forbidden contract, which is the
# point of three of the four below.
include_external_packages = True

[importlinter:contract:layers]
name = A layer may use what is below it, never what is above
type = layers
layers =
    salesforce_connector.mcp_server
    salesforce_connector.connector
    salesforce_connector.actions
    salesforce_connector.client
    salesforce_connector.auth
    salesforce_connector.schemas
    salesforce_connector.errors
    salesforce_connector.contract

[importlinter:contract:only_the_client_opens_a_socket]
name = Only the client may touch httpx
type = forbidden
# Direct imports only. Actions reach httpx through the client by design; what
# must not happen is an action importing it itself and bypassing the timeouts,
# retries, and error mapping that live there.
allow_indirect_imports = True
source_modules =
    salesforce_connector.contract
    salesforce_connector.errors
    salesforce_connector.schemas
    salesforce_connector.auth
    salesforce_connector.actions
    salesforce_connector.connector
forbidden_modules =
    httpx

[importlinter:contract:only_the_adapter_knows_the_protocol]
name = Only the adapter may import the MCP SDK
type = forbidden
source_modules =
    salesforce_connector.contract
    salesforce_connector.errors
    salesforce_connector.schemas
    salesforce_connector.auth
    salesforce_connector.client
    salesforce_connector.actions
    salesforce_connector.connector
forbidden_modules =
    mcp

[importlinter:contract:the_contract_depends_on_nothing]
name = The contract layer imports no vendor library at all
type = forbidden
source_modules =
    salesforce_connector.contract
forbidden_modules =
    httpx
    mcp
    jwt
    yaml
    tenacity
    structlog
    itsdangerous
    aiolimiter
