# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The connector reads .env from the directory it is started in. An exported
# environment variable of the same name wins over this file, which is what
# lets an MCP client pass credentials directly without a stray .env somewhere
# quietly replacing them.
#
# Authentication is the OAuth 2.0 JWT Bearer flow: the connector signs an
# assertion with a private key and exchanges it for an access token. There is
# no password here, and the username/password flow is not supported - Salesforce
# began retiring it in 2026.

# Consumer Key of the Connected App / External Client App.
SF_CLIENT_ID=

# Username the connector acts as. The Connected App must be pre-authorised for
# this user, and the user's profile decides what the five actions may do.
SF_USERNAME=integration.user@example.com.sandbox

# Private key matching the certificate uploaded to the Connected App, in PEM
# form. Keep the header and footer lines. Use \n between lines when the value
# must live on one line, as it must in most container runtimes.
SF_PRIVATE_KEY=

# Consumer Secret. Needed ONLY for the client credentials flow, which is the
# simpler fallback: no certificate, no signing. Leave this blank when using JWT
# bearer, which transmits no secret at all and is the default.
SF_CLIENT_SECRET=

# Login host. Sandbox by default and deliberately so: this connector is built
# and tested against a sandbox, with no production customer data.
# Production (https://login.salesforce.com) additionally requires
# SF_ALLOW_PRODUCTION=true, so it cannot happen by way of a typo.
SF_LOGIN_URL=https://test.salesforce.com

# Set only if a production org is genuinely intended.
SF_ALLOW_PRODUCTION=false

# Salesforce REST API version, pinned so a platform release cannot change
# behaviour underneath us.
SF_API_VERSION=v67.0

# Request timeouts in seconds. A read waits 10 and a write 22. Reads are cheap
# to abandon: nothing changed, so asking again is safe. A write is abandoned
# reluctantly, because it may already have been applied and giving up early
# makes that ambiguity more likely rather than less.
SF_READ_TIMEOUT_SECONDS=10.0
SF_WRITE_TIMEOUT_SECONDS=22.0

# Everything below has a working default and can be left alone. They were
# constants inside the modules that used them until it became clear that
# changing how often the connector retries meant reading errors/retry.py and
# editing a literal. A value somebody might reasonably want to change belongs
# where changing it is expected.

# How many times a retryable call is tried before it gives up and tells the
# user to do it by hand. Raising this makes the connector more patient with a
# flaky org; lowering it makes failures surface faster.
SF_MAX_ATTEMPTS=3

# Total wall clock one call may spend across all its attempts, including the
# waits between them. Whichever limit is reached first stops the retrying.
SF_RETRY_BUDGET_SECONDS=120.0

# Waiting for the socket to open, which is separate from waiting for an answer.
# A host that is down fails here in seconds rather than at the read timeout.
SF_CONNECT_TIMEOUT_SECONDS=5.0

# The connector's own rate limit, deliberately well under any org's daily API
# allowance. It refuses a call over budget rather than queuing it, so one
# runaway caller cannot exhaust the quota every other integration shares.
SF_CALLS_PER_MINUTE=60.0

# How long a person's approval of a write stays valid. A confirmation dialog
# left open longer than this is no longer treated as consent.
SF_APPROVAL_TTL_SECONDS=600

# The most rows one SOQL query may return when it names no LIMIT of its own,
# and the ceiling any LIMIT it does name is held to. An unbounded query pages
# an entire object and spends the org's daily allowance on a question nobody
# asked precisely.
SF_MAX_QUERY_ROWS=200

# How long one text value may be before it is shortened on the way out. Row
# counts are bounded by the setting above; this bounds how wide a row can be. A
# Salesforce long text area holds 32,000 characters, so a single record with a
# few of them filled can cost more context than the conversation it arrived in.
# Anything shortened says so in place and names itself in a warning, so nothing
# is lost quietly.
SF_MAX_FIELD_CHARACTERS=4000

