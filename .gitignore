# ---------------------------------------------------------------------------
# Secrets — DoD 8: no secrets in code, Git history, logs, fixtures, or
# recordings. These patterns come first because they matter most.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
# A certificate is the public half and leaking one is not a breach, but it
# arrives in the same `openssl req` command as the key it belongs to, and a
# stray one in a diff invites the question of where its key went.
*.crt
secrets/
# Unscrubbed recordings. Put anything straight from an org here and it cannot
# be committed by accident.
fixtures/raw/
credentials.json

# Recorded traffic that has not been scrubbed yet
fixtures/**/*.raw.json
*.har

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---------------------------------------------------------------------------
# Tooling caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
