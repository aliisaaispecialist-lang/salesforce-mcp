                  "    console.log('Refused: this writes to Salesforce and allow_writes is not true.');",
                  "    if (pm.execution && pm.execution.skipRequest) { pm.execution.skipRequest(); }",
                  "    pm.request.url = 'https://writes-are-off.invalid/refused';",
                  "}"
                ]
