            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{instance_url}}/services/data/{{api_version}}/sobjects/OpportunityContactRole",
            "description": "Backs opportunity_link_contact_by_id.\n\nWRITES. Refused unless allow_writes is true.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"OpportunityId\": \"{{opportunity_id}}\",\n  \"ContactId\": \"{{contact_id}}\"\n}"
            }
          }
        },
        {
          "name": "Log an activity",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
